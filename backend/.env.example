# FlavorAI Backend — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# MongoDB (Atlas URI)
MONGODB_URI=mongodb+srv://<db_name>:<db_password>@cluster0.osjwxv4.mongodb.net/<db_name>?appName=Cluster0

# JWT (shared with Better Auth signing; see docs/API_CONTRACT.md auth section)
JWT_SECRET=write-your-own-jwt-secret-here
JWT_ISSUER=flavorai
JWT_AUDIENCE=flavorai-api
JWT_EXPIRES_IN=15m

# Groq AI
GROQ_API_KEY=write-your-own-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=30000

# ImgBB
IMGBB_API_KEY=write-your-own-imgbb-api-key-here
IMGBB_API_URL=https://api.imgbb.com/1/upload