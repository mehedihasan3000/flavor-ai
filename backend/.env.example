# FlavorAI Backend — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# MongoDB (Atlas URI or local)
MONGODB_URI=mongodb://localhost:27017/flavorai

# JWT (shared with Better Auth signing; see docs/API_CONTRACT.md auth section)
JWT_SECRET=dev-only-change-me-please
JWT_ISSUER=flavorai
JWT_AUDIENCE=flavorai-api
JWT_EXPIRES_IN=15m

# Groq AI
GROQ_API_KEY=change-me
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_MS=30000

# ImgBB
IMGBB_API_KEY=change-me
IMGBB_API_URL=https://api.imgbb.com/1/upload