# FlavorAI Frontend — Environment Variables
# Copy to `.env.local` and fill in real values. Never commit.

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Better Auth (configured in M2/M5)
BETTER_AUTH_SECRET=write-your-own-secret-here
JWT_SECRET=write-your-own-jwt-secret-here
JWT_ISSUER=flavorai
JWT_AUDIENCE=flavorai-api

# Google OAuth 2.0 (server-only — never prefix with NEXT_PUBLIC_).
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and add GOOGLE_REDIRECT_URI
# as an Authorized redirect URI there.
GOOGLE_CLIENT_ID=write-your-own-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=write-your-own-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback