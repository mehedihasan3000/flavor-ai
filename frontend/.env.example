# FlavorAI Frontend — Environment Variables
# Copy to `.env.local` and fill in real values. Never commit.

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Better Auth (configured in M2/M5)
BETTER_AUTH_SECRET=write-your-own-secret-here
JWT_SECRET=write-your-own-jwt-secret-here
JWT_ISSUER=flavorai
JWT_AUDIENCE=flavorai-api

# Google Identity Services — real Google login (GIS)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Add https://localhost:3000 and your production domain to Authorized JavaScript origins
# and Authorized redirect URIs (if using code flow). Use the same value for both vars.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com